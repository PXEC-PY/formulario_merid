# Copy this file to .env.local and fill in real values. .env.local is gitignored — never
# commit real credentials. VITE_SUPABASE_ANON_KEY is Supabase's public "anon" key (safe
# for the browser, protected by Row Level Security policies on the database side) — the
# database password from the Postgres connection string is a DIFFERENT, much more
# sensitive secret and must never go here or anywhere in the frontend code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
